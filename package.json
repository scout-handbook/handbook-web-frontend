{
  "name": "skaut-handbook-web-frontend",
  "version": "1.1.3",
  "description": "A web interface for a Scout handbook",
  "keywords": [
    "education",
    "handbook",
    "odymaterialy",
    "scout",
    "skaut"
  ],
  "homepage": "https://github.com/scout-handbook/handbook-web-frontend",
  "bugs": {
    "url": "https://github.com/scout-handbook/handbook-web-frontend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scout-handbook/handbook-web-frontend.git"
  },
  "license": "MIT",
  "author": "Marek Dědič",
  "type": "module",
  "exports": {
    ".": null
  },
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "gulp build",
    "check": "FORCE_COLOR=1 run-p -c --aggregate-output check:*",
    "check:css-compat": "node scripts/check-css-compat.js",
    "check:js-compat": "es-check es2017 --checkFeatures 'dist/**/*.js'",
    "clean": "rimraf dist/*",
    "lint": "FORCE_COLOR=1 run-p -c --aggregate-output lint:*",
    "lint:css": "FORCE_COLOR=1 run-p -c --aggregate-output lint:css:*",
    "lint:css:stylelint": "stylelint --report-needless-disables 'src/**/*.css' '!src/css/fontello.css'",
    "lint:eslint": "eslint",
    "lint:typecheck": "FORCE_COLOR=1 run-p -c --aggregate-output lint:typecheck:*",
    "lint:typecheck:frontend": "tsc --noEmit -p frontend.tsconfig.json",
    "lint:typecheck:serviceworker": "tsc --noEmit -p serviceworker.tsconfig.json"
  },
  "browserslist": [
    "baseline 2019",
    "not edge 18"
  ],
  "dependencies": {
    "showdown": "^2.1.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/showdown": "^2.0.6",
    "@types/webfontloader": "^1.6.38",
    "autoprefixer": "^10.5.4",
    "doiuse": "^6.0.6",
    "es-check": "^9.6.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-package-json": "^1.7.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "gulp": "^5.0.1",
    "gulp-clean-css": "^4.2.0",
    "gulp-concat": "^2.6.1",
    "gulp-htmlmin": "^5.0.1",
    "gulp-inject-string": "^1.1.2",
    "gulp-postcss": "^10.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-typescript": "^5.0.1",
    "gulp-uglify": "^3.0.2",
    "npm-run-all": "^4.1.5",
    "ordered-read-streams": "^2.0.0",
    "postcss": "^8.5.26",
    "postcss-calc": "^11.0.1",
    "postcss-custom-properties": "^15.0.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "uglify-js": "^3.19.3"
  }
}
